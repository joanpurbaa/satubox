# --- Mayar ---
# Sandbox (test): buat akun di https://web.mayar.io lalu ambil API key
# Production: https://api.mayar.id
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.io
# Optional: merchant ID untuk validasi webhook (bisa dikosongkan saat test)
MAYAR_MERCHANT_ID=

# --- Firebase Admin (Firestore) ---
# Dari Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Prisma / Postgres (disiapkan, belum aktif) ---
DATABASE_URL=