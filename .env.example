# --- Firebase Admin (Backend) ---
# Dari Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Firebase Web (untuk login via REST signInWithPassword) ---
# Dari Firebase Console -> Project settings -> General -> Web API Key
NEXT_PUBLIC_FIREBASE_API_KEY=

# Nilai public/bukan rahasia (survive di bundle client)
NEXT_PUBLIC_SITE_URL=https://satubox.id